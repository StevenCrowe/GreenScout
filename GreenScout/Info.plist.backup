<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>NSCameraUsageDescription</key>
        <string>GreenScout needs access to your camera to capture field images for green coverage analysis.</string>
        <key>NSPhotoLibraryUsageDescription</key>
        <string>GreenScout needs access to your photo library to select field images for analysis.</string>
        <key>UILaunchScreen</key>
        <dict>
            <key>UIColorName</key>
            <string>AccentColor</string>
            <key>UIImageName</key>
            <string>AppIcon</string>
        </dict>
        <key>UIAppFonts</key>
            <array>
                <string>Rajdhani-Light.ttf</string>
                <string>Rajdhani-Regular.ttf</string>
                <string>Rajdhani-Medium.ttf</string>
                <string>Rajdhani-SemiBold.ttf</string>
                <string>Rajdhani-Bold.ttf</string>
            </array>
        
    </dict>
</plist>
